# Campaign machine defaults. Committed; contains no secrets.
# Secrets (HF_TOKEN, MDC_API_KEY, SUPERTURN_SSH_KEY and optional storage
# credentials) go in .env, which is git-ignored. See .env.example.

# Offer search (vast.ai query syntax). No source requires datacenter hosting,
# so verified community hosts with a good reliability record are allowed. On
# 2026-11-20 this matched 40 offers from $0.24/h (datacenter-only: 5).
VAST_QUERY="${VAST_QUERY:-verified=True reliability>0.98 num_gpus=1 gpu_ram>=24 cpu_cores_effective>=24 disk_space>=1000 inet_down>=500 cuda_vers>=12.4}"
VAST_ORDER="${VAST_ORDER:-dph}"
VAST_IMAGE="${VAST_IMAGE:-nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04}"
# The full plan is ~430 GB of downloads. Sources are processed into shards one
# at a time and their raw files deleted once the shards are written, so 1 TB
# leaves ample room.
VAST_DISK_GB="${VAST_DISK_GB:-1000}"

# Paths on the campaign machine.
REMOTE_REPO="${REMOTE_REPO:-/workspace/superturn}"
REMOTE_DATA="${REMOTE_DATA:-/workspace/data}"
