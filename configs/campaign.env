# Campaign machine defaults. Committed; contains no secrets.
# Secrets (HF_TOKEN, SUPERTURN_SSH_KEY and optional storage
# credentials) go in .env, which is git-ignored. See env.sample.

# Campaign 1 uses a single RTX 5090 in a verified South Korea datacenter.
VAST_TARGET="gpu_name=RTX_5090 geolocation=KR num_gpus=1 datacenter=True verified=True"
VAST_QUERY="${VAST_QUERY:-reliability>0.98 gpu_ram>=24 cpu_cores_effective>=16 disk_space>=200 inet_down>=300 cuda_vers>=12.8}"
VAST_ORDER="${VAST_ORDER:-dph_total}"
VAST_MAX_HOURLY="0.60"
VAST_IMAGE="${VAST_IMAGE:-nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04}"
# Downloads are capped at 20 GB (budget_gb in configs/sources.toml); 200 GB
# leaves room for decoded audio, shards, checkpoints and logs.
VAST_DISK_GB="${VAST_DISK_GB:-200}"

# Every job on the campaign machine runs as a window of this tmux session.
TMUX_SESSION="${TMUX_SESSION:-vxpipe}"

# Paths on the campaign machine.
REMOTE_REPO="${REMOTE_REPO:-/workspace/superturn}"
REMOTE_DATA="${REMOTE_DATA:-/workspace/data}"
