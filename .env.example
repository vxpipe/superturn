# Copy to .env (git-ignored) and fill in. Never commit .env.
HF_TOKEN=                 # Hugging Face token; Emilia access terms accepted
MDC_API_KEY=              # Mozilla Data Collective API key (Common Voice)
SUPERTURN_SSH_KEY=        # path to the private key registered with vast.ai
# Optional. Without it, bin/vast-down copies results (reports, logs, model
# files) back here and processed shards are discarded with the machine. Set it
# to keep shards between campaigns, e.g. store:superturn, and define the rclone
# remote via environment, for example for an S3-compatible bucket:
SUPERTURN_REMOTE=
# RCLONE_CONFIG_STORE_TYPE=s3
# RCLONE_CONFIG_STORE_PROVIDER=Other
# RCLONE_CONFIG_STORE_ENDPOINT=
# RCLONE_CONFIG_STORE_ACCESS_KEY_ID=
# RCLONE_CONFIG_STORE_SECRET_ACCESS_KEY=
