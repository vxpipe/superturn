#!/usr/bin/env bash
# Rent the campaign machine from an offer or machine ID, wait until
# it runs, push the repo and bootstrap it. Records the instance in .campaign/.
source "$(dirname "$0")/_lib.sh"
selection="${1:?usage: bin/vast-up OFFER_ID|machine:MACHINE_ID [--restore all|core|training|none]}"
restore=all
if [[ $# != 1 ]]; then
  [[ $# == 3 && "$2" == --restore ]] || die "usage: bin/vast-up OFFER_ID|machine:MACHINE_ID [--restore all|core|training|none]"
  restore="$3"
fi
[[ "$restore" == all || "$restore" == core || "$restore" == training || "$restore" == none ]] ||
  die "unknown restore profile"
if [[ ( "$restore" == core || "$restore" == training ) && -z "${SUPERTURN_REMOTE:-}" ]]; then
  die "a targeted restore requires SUPERTURN_REMOTE"
fi
[[ -s "$STATE/instance" ]] && die "instance $(cat "$STATE/instance") already recorded; bin/vast-down it first"
if [[ "$selection" =~ ^machine:([0-9]+)$ ]]; then
  field=machine_id
  value="${BASH_REMATCH[1]}"
elif [[ "$selection" =~ ^[0-9]+$ ]]; then
  field=id
  value="$selection"
else
  die "provide a numeric offer ID or machine:MACHINE_ID"
fi
offers="$(vast search offers "$VAST_QUERY $VAST_TARGET $field=$value" --storage "$VAST_DISK_GB" --raw)"
read -r offer price < <(printf '%s' "$offers" | python3 -c '
import json
import sys

offers = json.load(sys.stdin)
field, value, cap = sys.argv[1:]
matches = [offer for offer in offers
           if str(offer[field]) == value and float(offer["dph_total"]) < float(cap)]
if matches:
    best = min(matches, key=lambda offer: float(offer["dph_total"]))
    price = float(best["dph_total"])
    print(best["id"], f"{price:.4f}")
' "$field" "$value" "$VAST_MAX_HOURLY") ||
  die "offer is unavailable, fails campaign filters, or exceeds the hourly price cap"
printf 'verified campaign offer at $%s/h\n' "$price"
out="$(vast create instance "$offer" --image "$VAST_IMAGE" --disk "$VAST_DISK_GB" --ssh --direct --raw)"
id="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["new_contract"])' "$out")"
echo "$id" > "$STATE/instance"
echo "instance $id created; waiting for it to run"
for _ in $(seq 1 90); do
  status="$(vast show instance "$id" --raw | python3 -c 'import json,sys; print(json.load(sys.stdin).get("actual_status"))')"
  [[ "$status" == "running" ]] && break
  sleep 20
done
[[ "$status" == "running" ]] || die "instance $id not running after 30 min (status: $status)"
sleep 20   # let sshd come up
"$ROOT/bin/vast-push"
remote "bash $REMOTE_REPO/bin/vast-bootstrap"
if [[ -n "${SUPERTURN_REMOTE:-}" && "$restore" == all ]]; then
  echo "pulling all standard campaign data from private storage"
  remote "cd $REMOTE_REPO && export SUPERTURN_DATA=$REMOTE_DATA && bin/sync pull" || die "pull from storage failed; instance $id kept"
elif [[ "$restore" == core || "$restore" == training ]]; then
  echo "restoring the $restore profile from private storage"
  remote "cd $REMOTE_REPO && export SUPERTURN_DATA=$REMOTE_DATA && bin/campaign-handoff pull $restore" ||
    die "pull from storage failed; instance $id kept"
fi
echo "instance $id ready. Next: bin/vast-run -n smoke 'bin/campaign-smoke --device cuda'"
