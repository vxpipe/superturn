#!/usr/bin/env bash
# Show the campaign machine's progress: each long step (download, labelling,
# sharding, training, benchmarks) with how much is done, the measured pace and
# the estimated time left, plus the running tmux jobs and disk use.
# Usage: bin/vast-progress
source "$(dirname "$0")/_lib.sh"
remote "cd $REMOTE_REPO && export SUPERTURN_DATA=$REMOTE_DATA && uv run --quiet superturn progress; echo; echo 'jobs:'; tmux ls 2>/dev/null || echo '  none running'; echo; df -h $REMOTE_DATA | tail -1"
