#!/usr/bin/env bash
# Show the campaign machine's progress: each long step (download, labelling,
# sharding, training, benchmarks) with how much is done, the measured pace and
# the estimated time left, plus the jobs in the tmux session $TMUX_SESSION
# (vxpipe) and disk use.
# Usage: bin/vast-progress
source "$(dirname "$0")/_lib.sh"
remote "cd $REMOTE_REPO && export SUPERTURN_DATA=$REMOTE_DATA && uv run --quiet --no-sync superturn progress; echo; echo 'jobs (tmux session $TMUX_SESSION):'; tmux list-windows -t $TMUX_SESSION -F '  #W' 2>/dev/null || echo '  none running'; echo; df -h $REMOTE_DATA | tail -1"
