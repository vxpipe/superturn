#!/usr/bin/env bash
# Watch the campaign machine and print progress events locally. Start it
# as soon as a campaign job starts and keep it running until bin/vast-down.
#   bin/vast-watch [--every MIN] [--summary MIN] [--once]
# Prints each event once: job started, finished or failed; long steps at each
# quarter; a step's first time
# estimate once its pace is measured; a step that stopped updating; a summary
# every --summary minutes (default 60); the machine idle but still rented;
# the machine unreachable, and back. Check every 30 seconds unless --every MIN is set.
# --once checks a single time and exits (for an agent's own monitoring loop).
# Stops by itself when no campaign instance is recorded any more.
source "$(dirname "$0")/_lib.sh"
interval=30; summary=60; once=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --every) interval="$(($2 * 60))"; shift 2 ;;
    --summary) summary="$2"; shift 2 ;;
    --once) once=1; shift ;;
    *) die "usage: bin/vast-watch [--every MIN] [--summary MIN] [--once]" ;;
  esac
done
log_event() { echo "$(date -u +%H:%M) $*"; }

failures=0
while true; do
  [[ -s "$STATE/instance" ]] || { echo "no campaign instance recorded; stopping"; exit 0; }
  id="$(cat "$STATE/instance")"
  if status="$(remote "cd $REMOTE_REPO && source configs/campaign.env && export SUPERTURN_DATA=$REMOTE_DATA TMUX_SESSION && uv run --quiet --no-sync superturn status" 2>/dev/null)"; then
    (( failures >= 3 )) && log_event "machine $id reachable again"
    failures=0
    while IFS= read -r msg; do
      [[ -n "$msg" ]] && log_event "$msg"
    done < <(printf '%s' "$status" | (cd "$ROOT" && uv run --quiet superturn watch-events --state "$STATE/watch-$id.json" --summary-minutes "$summary"))
  else
    failures=$((failures + 1))
    (( failures == 3 )) && log_event "machine $id unreachable for 3 checks (${interval}s apart); jobs in tmux keep running"
  fi
  (( once )) && exit 0
  sleep "$interval"
done
