#!/usr/bin/env bash
# Run a command on the campaign machine as a window of the tmux session
# vxpipe (survives disconnects), logging to $REMOTE_DATA/logs/<name>.log.
# Usage: bin/vast-run [-n NAME] 'command'
# Then: bin/vast-progress to check, bin/vast-watch to be notified.
source "$(dirname "$0")/_lib.sh"
name="job-$(date +%Y%m%d-%H%M%S)"
if [[ "${1:-}" == "-n" ]]; then name="$2"; shift 2; fi
cmd="${1:?usage: bin/vast-run [-n NAME] 'command'}"
printf '%s\n' "cd $REMOTE_REPO && export SUPERTURN_DATA=$REMOTE_DATA" "$cmd" |
  remote "bash $REMOTE_REPO/bin/job-run start '$name'"
echo "follow with: bin/vast-ssh tail -f $REMOTE_DATA/logs/$name.log (or bin/vast-ssh tmux attach -t $TMUX_SESSION)"
