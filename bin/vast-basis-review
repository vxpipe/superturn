#!/usr/bin/env bash
# Serve a blind review packet on Vast and forward it to the local loopback.
source "$(dirname "$0")/_lib.sh"

case "${2:-basis}" in
  basis) packet=basis; port=8769; bundle=superturn-basis-review; flags=--basis; ballots="" ;;
  harper) packet=harper; port=8770; bundle=superturn-harper-review; flags=--harper
          ballots="REVIEW_BALLOTS=$REMOTE_DATA/labels/harper-text-review" ;;
  harper-supplement) packet=harper-supplement; port=8771; bundle=superturn-harper-supplement
          flags="--harper --harper-supplement"
          ballots="REVIEW_BALLOTS=$REMOTE_DATA/labels/harper-text-supplement-review" ;;
  harper-plausibility) packet=harper-plausibility; port=8772; bundle=superturn-harper-text-plausibility
          flags="--harper --harper-plausibility"
          ballots="REVIEW_BALLOTS=$REMOTE_DATA/labels/harper-text-plausibility-review" ;;
  publisher-plausibility) packet=publisher-plausibility; port=8773; bundle=superturn-publisher-text-plausibility
          flags="--publisher-plausibility"
          ballots="REVIEW_BALLOTS=$REMOTE_DATA/labels/publisher-text-plausibility-review" ;;
  *) die "unknown review packet" ;;
esac

case "${1:-}" in
  start)
    ssh_target
    mapfile -t opts < <(ssh_opts)
    node_bin="$(command -v node)" || die "Node is required to build the review app"
    (cd "$ROOT/review-app" && npm run build)
    remote "install -d -m 700 $REMOTE_REPO/review-app/.runtime"
    rsync -az -e "ssh ${opts[*]}" "$ROOT/review-app/dist" "$ROOT/review-app/node_modules" \
      "$SSH_HOST:$REMOTE_REPO/review-app/"
    rsync -azL -e "ssh ${opts[*]}" "$node_bin" "$SSH_HOST:$REMOTE_REPO/review-app/.runtime/node"
    "$ROOT/bin/vast-run" -n "$packet-review" \
      "ulimit -c 0; cd review-app && $ballots REVIEW_BUNDLE=/dev/shm/$bundle PORT=$port .runtime/node server.mjs --independent $flags"
    ;;
  tunnel)
    ssh_target
    mapfile -t opts < <(ssh_opts)
    exec ssh "${opts[@]}" -o ExitOnForwardFailure=yes -fN \
      -L "127.0.0.1:$port:127.0.0.1:$port" "$SSH_HOST"
    ;;
  *) die "usage: bin/vast-basis-review start|tunnel [basis|harper|harper-supplement|harper-plausibility|publisher-plausibility]" ;;
esac
