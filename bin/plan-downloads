#!/usr/bin/env bash
# Price every source (or --only NAMES) from provider file listings. Downloads
# nothing, so it is safe to run anywhere. Add --sample for the smoke-test subset.
set -euo pipefail
cd "$(dirname "$0")/.."
[[ -f .env ]] && { set -a; source .env; set +a; }
exec uv run superturn plan "$@"
