# Copy to .env (git-ignored) and fill in: cp env.sample .env
# Never commit .env. bin/vast-push copies it to the rented machine.

# Hugging Face read-only token from the account that accepted the Emilia
# access terms. Needed for the gated Emilia-YODAS download.
HF_TOKEN=todo

# Optional: path to the private SSH key registered with vast.ai, passed to
# ssh/rsync as -i. Leave empty if ssh already finds that key (ssh-agent, or an
# IdentityFile in ~/.ssh/config). Only the path is used; the key is not copied.
SUPERTURN_SSH_KEY=

# Persistent storage for raw downloads, labels, shards and results, so later
# campaigns skip downloading and labelling. Any rclone remote named "store";
# Cloudflare R2 shown. SUPERTURN_REMOTE is store:<bucket>[/prefix]. The R2 API
# token needs Object Read & Write on that bucket only; NO_CHECK_BUCKET stops
# rclone trying to create the bucket, which such a token may not do. Keep the
# bucket private. Leave SUPERTURN_REMOTE empty to keep nothing between campaigns.
SUPERTURN_REMOTE=
# RCLONE_CONFIG_STORE_TYPE=s3
# RCLONE_CONFIG_STORE_PROVIDER=Cloudflare
# RCLONE_CONFIG_STORE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# RCLONE_CONFIG_STORE_ACCESS_KEY_ID=todo
# RCLONE_CONFIG_STORE_SECRET_ACCESS_KEY=todo
# RCLONE_CONFIG_STORE_NO_CHECK_BUCKET=true
