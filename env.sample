# Copy to .env (git-ignored) and fill in: cp env.sample .env
# Never commit .env. bin/vast-push copies it to the rented machine.

# Hugging Face read-only token from the account that accepted the Emilia
# access terms. Needed for the gated Emilia-YODAS download.
HF_TOKEN=todo

# Optional: path to the private SSH key registered with vast.ai, passed to
# ssh/rsync as -i. Leave empty if ssh already finds that key (ssh-agent, or an
# IdentityFile in ~/.ssh/config). Only the path is used; the key is not copied.
SUPERTURN_SSH_KEY=

# Optional, normally empty: an rclone remote to keep processed shards between
# campaigns (e.g. store:superturn). Without it, bin/vast-down copies results and
# model files back here and shards are discarded with the machine.
SUPERTURN_REMOTE=
# RCLONE_CONFIG_STORE_TYPE=s3
# RCLONE_CONFIG_STORE_PROVIDER=Other
# RCLONE_CONFIG_STORE_ENDPOINT=todo
# RCLONE_CONFIG_STORE_ACCESS_KEY_ID=todo
# RCLONE_CONFIG_STORE_SECRET_ACCESS_KEY=todo
