{
  "name": "superturn-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server.mjs --dev",
    "dev:web": "vite --strictPort",
    "build": "vite build",
    "start": "node server.mjs",
    "prepare-independent": "node prepare-independent.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "vite": "^8.3.8"
  }
}
